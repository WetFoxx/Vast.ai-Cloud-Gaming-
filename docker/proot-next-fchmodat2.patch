diff --git a/tests/e2e.rs b/tests/e2e.rs
index 8dfe807..0b89034 100644
--- a/tests/e2e.rs
+++ b/tests/e2e.rs
@@ -492,0 +493,28 @@ fn compile_probe(name: &str, dir: &Path) -> PathBuf {
+/// A container profile that refuses `fchmodat2` does not break `chmod`: the
+/// supervisor falls back to `fchmodat` on the pinned object's `/proc` link.
+#[test]
+fn chmod_survives_fchmodat2_seccomp_refusal() {
+    let d = tmpdir("chmod-fchmodat2");
+    let wrapper = compile_probe("denyfchmodat2", &d);
+    std::fs::write(d.join("file"), "content").unwrap();
+    let bind = format!("{}:/pn-chmod", d.display());
+    let args = [
+        "-r",
+        "/",
+        "-b",
+        &bind,
+        "/bin/sh",
+        "-c",
+        "chmod 640 /pn-chmod/file && stat -c %a /pn-chmod/file",
+    ];
+    for no_ptrace in [false, true] {
+        let mut cmd = Command::new(&wrapper);
+        cmd.arg(proot()).args(args);
+        if no_ptrace {
+            cmd.env("PROOT_NO_PTRACE", "1");
+        }
+        let o = cmd.output().unwrap();
+        assert_eq!(stdout(&o), "640", "{}", String::from_utf8_lossy(&o.stderr));
+    }
+}
