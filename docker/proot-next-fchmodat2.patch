diff --git a/tests/probes/denyfchmodat2.c b/tests/probes/denyfchmodat2.c
new file mode 100644
index 0000000..bd8e948
--- /dev/null
+++ b/tests/probes/denyfchmodat2.c
@@ -0,0 +1,37 @@
+/*
+ * Runs a command under a seccomp filter that refuses fchmodat2 with ENOSYS,
+ * as older container runtimes' default profiles do.
+ *
+ *   denyfchmodat2 COMMAND [ARG...]
+ */
+#include <linux/filter.h>
+#include <linux/seccomp.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <sys/prctl.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#include <errno.h>
+
+#ifndef SYS_fchmodat2
+#define SYS_fchmodat2 452
+#endif
+
+int main(int argc, char **argv) {
+    if (argc < 2)
+        return 2;
+    struct sock_filter f[] = {
+        BPF_STMT(BPF_LD | BPF_W | BPF_ABS, offsetof(struct seccomp_data, nr)),
+        BPF_JUMP(BPF_JMP | BPF_JEQ | BPF_K, SYS_fchmodat2, 0, 1),
+        BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ERRNO | ENOSYS),
+        BPF_STMT(BPF_RET | BPF_K, SECCOMP_RET_ALLOW),
+    };
+    struct sock_fprog prog = {sizeof f / sizeof f[0], f};
+    if (prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) || syscall(SYS_seccomp, SECCOMP_SET_MODE_FILTER, 0, &prog)) {
+        perror("denyfchmodat2: seccomp");
+        return 2;
+    }
+    execvp(argv[1], argv + 1);
+    perror("denyfchmodat2: exec");
+    return 127;
+}
