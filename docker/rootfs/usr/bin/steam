#!/bin/bash
# /usr/bin/steam в vastgame-desktop: Steam в контейнере без user namespaces. Настоящий запускатель Valve —
# /opt/vastgame/real/steam (ссылка на bin_steam.sh: он узнаёт свой режим по имени файла, «steam.real» не годится).
# Заплатки (steam-patch.sh) ставятся перед запуском и держатся, пока Steam работает; если обновление клиента
# их откатило и Steam вышел с «Steam now requires user namespaces» (код 71) — заплатка и перезапуск.
# Геймпад: библиотека vgpad в играх (LD_PRELOAD — Steam передаёт играм сам), SDL ищет джойстики без udev.
# -cef-disable-gpu-compositing — иначе Big Picture чёрный (GLXBadPixmap).
# VG (пустая, но заданная) включает условные заплатки Steam (steam-patch.py): без неё — на KVM, куда файлы
# Steam приезжают из общего облака, — заплатки ведут себя как оригинал.
ME=$(id -u)
export LD_PRELOAD="libvgpad.so${LD_PRELOAD:+:$LD_PRELOAD}" SDL_JOYSTICK_DISABLE_UDEV=1 VG=
# [2026-10-15] Экран без монитора (/run/vastgame/headless — выходом видеокарты владеет хост): у X-сервера нет выходов
# RandR, и Steam не открывал ни одного окна («CreateOutputWindow: Could not find display info», GTX 1660 S Вьетнам).
# SDL без XRandR берёт размер экрана целиком — окна открываются (проверено вживую); игры наследуют то же
[ -e /run/vastgame/headless ] && export SDL_VIDEO_X11_XRANDR=0
# [2026-10-16] Только видеокарта NVIDIA в Vulkan: без встроенной карты ноутбука (Intel/AMD) и программной заглушки Mesa,
# на которых игры DirectX 12 отвечают «видеокарта не поддерживает DX12»
for icd in /etc/vulkan/icd.d/nvidia_icd.json /usr/share/vulkan/icd.d/nvidia_icd.json /etc/vulkan/icd.d/nvidia_icd.x86_64.json; do
  [ -s "$icd" ] && { export VK_DRIVER_FILES="$icd" VK_ICD_FILENAMES="$icd"; break; }
done
# [2026-10-16] Временные папки Windows в префиксах Proton: архивы pfx--* выгружаются без Temp,
# а библиотеки DLSS/Reflex (sl.common.dll) падают при старте с filesystem_error, если Temp не создан
for pfx in "$HOME"/.steam/debian-installation/steamapps/compatdata/*/pfx/drive_c "$HOME"/.steam/steam/steamapps/compatdata/*/pfx/drive_c; do
  [ -d "$pfx/users/steamuser" ] && mkdir -p "$pfx/users/steamuser/AppData/Local/Temp" "$pfx/users/steamuser/Temp" "$pfx/users/steamuser/Documents" "$pfx/windows/temp" 2>/dev/null
done
# Steam уже работает — передать ему команду (steam://…) и выйти
if pgrep -u "$ME" -f 'ubuntu12_32/steam( |$)' >/dev/null; then exec /opt/vastgame/real/steam "$@"; fi
exec 9>"/tmp/steam-run-$ME.lock"
flock -n 9 || exec /opt/vastgame/real/steam "$@"          # другой запуск уже присматривает
/opt/vastgame/steam-patch.sh watch &
W=$!
trap 'kill $W 2>/dev/null' EXIT
for try in 1 2 3 4 5 6 7 8; do
  /opt/vastgame/steam-patch.sh once
  /opt/vastgame/real/steam -cef-disable-gpu-compositing "$@"
  rc=$?
  [ "$rc" = 71 ] || break
  echo "[steam] проверка user namespaces вернулась (обновление клиента?) — заплатка и перезапуск $try" >&2
  sleep 2
done
exit "${rc:-0}"
