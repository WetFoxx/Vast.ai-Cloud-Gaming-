# Виртуальное окружение — воссоздаётся командой python3 -m venv .venv
.venv/
# Служебные файлы Python
__pycache__/
# Секреты — никогда не в git
.env
*.key
# Служебный файл Finder
.DS_Store
# Настройки Claude Code для этого Mac (абсолютные пути)
.claude/
# OAuth-клиент Google приложения — встраивается при сборке, в git не попадает
oauth_client.json
build/
dist/
dist.noindex/
# Старые выпуски, скачанные с GitHub. В git не класть.
archive/releases/
# Ключ подписи выпусков: резервная копия (*.pem) — никогда не в git; открытый ключ после keygen вшивается в updater.py
*.pem
release-public-key.txt
